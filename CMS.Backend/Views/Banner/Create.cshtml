@{
    ViewData["Title"] = "Create";
}
@{
    Layout = "_LayoutAdmin";
}

@model CMS.Data.Entities.Banner

<div class="container mt-4">
    <h2 class="text-primary">THÊM BANNER MỚI</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">Tiêu đề banner:</label>
            <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề hoặc tên banner..." />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Đường dẫn hình ảnh (URL):</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="Ví dụ: /images/banner1.jpg" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Đường dẫn liên kết (Khi click vào ảnh):</label>
            <input asp-for="LinkUrl" class="form-control" placeholder="Ví dụ: /san-pham/sach-moi" />
        </div>

        <div class="mb-3">
            <label class="form-label">Thứ tự hiển thị:</label>
            <input asp-for="Order" type="number" class="form-control" value="0" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
            <label class="form-check-label fw-bold" asp-for="IsActive">Kích hoạt hiển thị ngay</label>
        </div>

        <button type="submit" class="btn btn-success">Lưu vào hệ thống</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>
