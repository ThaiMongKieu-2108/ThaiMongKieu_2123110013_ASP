@{
    ViewData["Title"] = "Index";
}
@{
    Layout = "_LayoutAdmin";
}
@model IEnumerable<CMS.Data.Entities.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="d-flex justify-content-between align-items-center mb-3" style="margin-top: 20px;">
    <h2>Danh sách Banner Quảng Cáo</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm Banner Mới</a>
</div>

<table class="table table-bordered table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr class="text-center">
            <th style="width: 15%;">Hình ảnh</th>
            <th>Tiêu đề</th>
            <th>Liên kết (LinkUrl)</th>
            <th style="width: 10%;">Thứ tự</th>
            <th style="width: 12%;">Trạng thái</th>
            <th style="width: 15%;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">
                        <img src="@item.ImageUrl" alt="@item.Title" style="max-width: 100%; max-height: 80px; object-fit: cover; border-radius: 4px;" />
                    </td>
                    <td><strong>@item.Title</strong></td>
                    <td><a href="@item.LinkUrl" target="_blank">@item.LinkUrl</a></td>
                    <td class="text-center">@item.Order</td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Đang hiển thị</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Đang ẩn</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa banner này không?')">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Chưa có banner nào được tạo.</td>
            </tr>
        }
    </tbody>
</table>