@model CMS.Data.Entities.CategoryProduct

<h2>Cập nhật danh mục sản phẩm</h2>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label>Tên danh mục</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Đường dẫn ảnh đại diện (Khối tròn FrontEnd)</label>
        <input asp-for="ImageUrl" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mt-2">
                <span class="text-muted d-block small mb-1">Ảnh hiện tại:</span>
                <img src="@Model.ImageUrl" style="width: 70px; height: 70px; object-fit: cover; border-radius: 50%;" class="border shadow-sm" />
            </div>
        }
    </div>

    <div class="mb-3">
        <label>Thứ tự hiển thị</label>
        <input asp-for="DisplayOrder" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mô tả</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label class="form-check-label">Hoạt động</label>
    </div>

    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}