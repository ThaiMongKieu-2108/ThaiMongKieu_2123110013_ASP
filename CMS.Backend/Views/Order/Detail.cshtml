@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2 class="mb-4">
    Chi tiết đơn hàng #@Model.Id
</h2>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <p class="mb-2"><strong>Khách hàng:</strong> @(Model.Customer?.FullName ?? "Khách vãng lai")</p>
        <p class="mb-2"><strong>Email:</strong> @(Model.Customer?.Email ?? "N/A")</p>
        <p class="mb-2"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        <p class="mb-0"><strong>Ghi chú:</strong> @Model.Notes</p>
    </div>
</div>

<h4 class="mb-3 font-weight-bold text-secondary">Danh sách sản phẩm đã đặt</h4>

<table class="table table-bordered table-striped bg-white">
    <thead class="thead-light">
        <tr>
            <th>Sản phẩm</th>
            <th class="text-right">Giá</th>
            <th class="text-center">Số lượng</th>
            <th class="text-right">Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
        {
            decimal totalOrderPrice = 0;
            foreach (var item in Model.OrderDetails)
            {
                var rowTotal = item.Quantity * item.UnitPrice;
                totalOrderPrice += rowTotal;
                <tr>
                    <td>@item.Product?.Name</td>
                    <td class="text-right">@item.UnitPrice.ToString("#,##0") đ</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-right font-weight-bold text-danger">@rowTotal.ToString("#,##0") đ</td>
                </tr>
            }
            <tr class="bg-light font-weight-bold text-dark">
                <td colspan="3" class="text-right">Tổng tiền thanh toán:</td>
                <td class="text-right text-danger h5 font-weight-bold">@totalOrderPrice.ToString("#,##0") đ</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center py-4 text-muted font-italic">
                    ⚠ Hệ thống không tìm thấy chi tiết sản phẩm của đơn hàng này trong Database.
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary px-4">
        <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
    </a>
</div>