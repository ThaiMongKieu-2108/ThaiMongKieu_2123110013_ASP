@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <!-- Breadcrumb (Đường dẫn điều hướng) -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4" style="background: transparent; padding-left: 0;">
            <li class="breadcrumb-item"><a href="/Post" class="text-decoration-none" style="color: #0d6efd;">Danh sách bài viết</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">Chi tiết bài viết</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-10 offset-md-1">
            <!-- 1. Tiêu đề bài viết lớn (Màu xanh dương) -->
            <h1 class="fw-bold mb-3" style="color: #0d6efd; font-size: 2.8rem; line-height: 1.2; font-family: Arial, sans-serif;">
                @Model.Title
            </h1>

            <!-- 2. Hiển thị Tên danh mục (Badge) và Ngày đăng -->
            <div class="d-flex align-items-center gap-3 mb-3">
                @if (Model.Category != null)
                {
                    <span class="badge text-white" style="background-color: #00bcd4; font-size: 0.8rem; padding: 6px 10px; border-radius: 4px; font-weight: bold;">
                        @Model.Category.Name
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary text-white" style="font-size: 0.8rem; padding: 6px 10px; border-radius: 4px;">
                        Chưa phân loại
                    </span>
                }

                <span class="text-muted" style="font-size: 0.95rem;">
                    Đăng ngày: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>

            <!-- Đường kẻ ngang phân tách -->
            <hr class="my-4" style="border-color: #cbd5e1;" />

            <!-- 3. Ảnh bài viết lớn được bo góc và đổ bóng nhẹ -->
            <div class="text-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-thumbnail.jpg" : Model.ImageUrl)"
                     class="img-fluid rounded shadow-sm border"
                     alt="@Model.Title"
                     style="width: 100%; max-height: 500px; object-fit: cover;">
            </div>

            <!-- 4. Nội dung bài viết chi tiết -->
            <div class="post-content fs-5 text-dark" style="line-height: 1.8; text-align: justify; font-family: Georgia, serif;">
                @Model.Content
            </div>

            <!-- 5. Nút quay lại danh sách -->
            <div class="mt-5 border-top pt-4">
                <a href="/Post" class="btn btn-secondary px-4 py-2" style="background-color: #6c757d; border-color: #6c757d; border-radius: 4px; font-weight: 500;">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>