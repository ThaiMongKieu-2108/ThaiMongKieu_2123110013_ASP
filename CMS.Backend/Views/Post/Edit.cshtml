@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa bài viết";
}

<div class="container mt-4">
    <div class="card shadow">

        <!-- Header -->
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                CHỈNH SỬA BÀI VIẾT
            </h4>
        </div>

        <div class="card-body">

            <!-- Form Edit -->
            <form asp-action="Edit" method="post">

                <!-- Hidden ID -->
                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <!-- Cột trái -->
                    <div class="col-md-8">

                        <!-- Tiêu đề -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Tiêu đề bài viết:
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Nhập tiêu đề..." />
                        </div>

                        <!-- Nội dung -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Nội dung chi tiết:
                            </label>

                            <textarea asp-for="Content"
                                      class="form-control"
                                      rows="10"
                                      placeholder="Viết nội dung tại đây..."></textarea>
                        </div>

                    </div>

                    <!-- Cột phải -->
                    <div class="col-md-4">

                        <!-- Danh mục -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Chuyên mục:
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    asp-items="ViewBag.CategoryList">

                                <option value="">
                                    -- Chọn danh mục --
                                </option>

                            </select>
                        </div>

                        <!-- Ảnh -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Link ảnh đại diện (URL):
                            </label>

                            <input asp-for="ImageUrl"
                                   class="form-control"
                                   placeholder="https://..." />
                        </div>

                        <!-- Ngày đăng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Ngày đăng:
                            </label>

                            <input asp-for="CreatedDate"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <hr />

                        <!-- Nút -->
                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-warning text-dark">

                                <i class="bi bi-save"></i>
                                Cập nhật bài viết

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Quay lại danh sách

                            </a>

                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
