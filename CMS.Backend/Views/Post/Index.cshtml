@{
    Layout = "_LayoutAdmin";
}


@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <!-- Tiêu đề trang và Nút thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-uppercase m-0 text-dark" style="font-family: Arial, sans-serif; letter-spacing: 0.5px;">Danh sách bài viết</h2>
        <a href="/Post/Create" class="btn btn-success d-flex align-items-center px-3 py-2" style="border-radius: 6px; font-weight: 500;">
            <i class="bi bi-plus-circle me-2"></i> Thêm bài viết mới
        </a>
    </div>

    <!-- Danh sách Grid Card -->
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border" style="border-radius: 8px; overflow: hidden; border-color: #e2e8f0 !important;">
                    <!-- Ảnh bài viết -->
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-thumbnail.jpg" : item.ImageUrl)"
                         class="card-img-top"
                         alt="@item.Title"
                         style="height: 220px; object-fit: cover;">

                    <div class="card-body d-flex flex-column p-3">
                        <!-- Danh mục (Badge) -->
                        <div class="mb-2">
                            @if (item.Category != null)
                            {
                                <span class="badge text-white" style="background-color: #00bcd4; font-size: 0.75rem; padding: 5px 8px; border-radius: 4px;">
                                    @item.Category.Name
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white" style="font-size: 0.75rem; padding: 5px 8px; border-radius: 4px;">
                                    Chưa phân loại
                                </span>
                            }
                        </div>

                        <!-- Tiêu đề bài viết -->
                        <h5 class="card-title fw-bold mb-2">
                            <a href="/Post/Details/@item.Id" class="text-decoration-none" style="color: #0d6efd; font-size: 1.15rem; line-height: 1.4;">
                                @item.Title
                            </a>
                        </h5>

                        <!-- Đoạn trích nội dung ngắn -->
                        <p class="card-text text-muted flex-grow-1 mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.9rem; line-height: 1.5; height: 2.7rem;">
                            @item.Content
                        </p>

                        <!-- Ngày đăng -->
                        <p class="text-muted small mb-3">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <!-- Nhóm nút hành động ở góc dưới -->
                        <div class="d-flex gap-1 mt-auto">
                            <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm px-2 py-1" style="border-radius: 4px; font-size: 0.85rem;">
                                Xem chi tiết
                            </a>
                            <a href="/Post/Edit/@item.Id" class="btn btn-outline-warning btn-sm px-2 py-1" style="border-radius: 4px; font-size: 0.85rem; color: #ffc107; border-color: #ffc107;">
                                Sửa
                            </a>
                           
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                                <i class="bi bi-trash"></i> Xóa
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>